{
  "name": "opencode-zcode-auth",
  "version": "0.1.39",
  "description": "OpenCode provider plugin: signs in to Z.ai's or BigModel's (智谱) GLM Coding Plan as ZCode does, including team seats and ZCode's Start Plan, and claims its gift plans daily",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "prompt.mjs",
    "README.md",
    "page"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "zcode",
    "z.ai",
    "bigmodel",
    "glm",
    "coding-plan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/player462/opencode-zcode-auth.git"
  },
  "magpie": {
    "maxConcurrency": 3,
    "page": {
      "title": "ZCode gifts",
      "titles": {
        "zh": "ZCode 礼包",
        "zh-TW": "ZCode 禮包",
        "ja": "ZCode ギフト",
        "de": "ZCode-Geschenke"
      },
      "file": "page/index.html"
    }
  }
}
