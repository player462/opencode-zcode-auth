{
  "name": "opencode-zcode-auth",
  "version": "0.1.53",
  "description": "OpenCode / magpie provider plugin for ZCode (Z.ai + BigModel GLM Coding Plan): signs in like ZCode 3.17.2, claims the gift plans ZCode advertises — solving the Aliyun captcha a guarded claim asks for, hands-free — and says what an empty account means instead of the vendor text",
  "type": "module",
  "main": "./opencode.mjs",
  "exports": {
    ".": "./opencode2.mjs"
  },
  "files": [
    "index.mjs",
    "opencode.mjs",
    "opencode2.mjs",
    "prompt.mjs",
    "README.md",
    "page"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "zcode",
    "z.ai",
    "bigmodel",
    "glm",
    "coding-plan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/player462/opencode-zcode-auth.git"
  },
  "magpie": {
    "maxConcurrency": 3,
    "maxAccounts": 2,
    "page": {
      "title": "ZCode gifts",
      "titles": {
        "zh": "ZCode 礼包",
        "zh-TW": "ZCode 禮包",
        "ja": "ZCode ギフト",
        "de": "ZCode-Geschenke"
      },
      "file": "page/index.html"
    }
  }
}
